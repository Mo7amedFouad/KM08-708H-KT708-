# Slim USB-only seed for OmarAL-Dev/mercury_km08-708h (openwrt-25.12 base).
# This is a SEED config: CI runs `make defconfig` to expand it into the full
# ~7000-line .config. Do not hand-add generated symbols here; add one
# CONFIG_PACKAGE_*=y line per wanted package and let defconfig resolve deps.
#
# Policy: device + LuCI + USB storage only. No xray, tailscale, adblock,
# sqm, DoH, or extra feeds (see diy-part1.sh note).

# Target: Mercury KM08-708H (MT7621AT, MT7615DN, NAND)
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_mercury_km08-708h=y
CONFIG_VERSION_NUMBER="25.12-KM08-708H"

# LuCI web interface only (default bootstrap theme)
CONFIG_PACKAGE_luci=y

# USB storage stack (sole extras on top of target defaults)
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y

# WiFi helpers (same as proven 25.12 recipe)
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iw=y
