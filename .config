# Slim seed for openwrt/openwrt openwrt-24.10 + tree overrides (files/).
# Expanded by `make defconfig` in CI. One CONFIG_PACKAGE_*=y per wanted
# package; defconfig resolves deps.
#
# Policy: device + LuCI + WiFi AP + USB/storage + tunnel/proxy kmods.
# No xray, tailscale(userspace), adblock, sqm, DoH, or other extras.

# Target: Mercury KM08-708H (MT7621AT, MT7615DN, NAND).
# NOTE: upstream 24.10 has no mercury_km08-708h support — files/ carries
# the DTS, mt7621.mk stanza, 01_leds entry and uboot-envtools overrides.
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_mercury_km08-708h=y
CONFIG_VERSION_NUMBER="24.10-KM08-708H"

# LuCI web interface (default bootstrap theme)
CONFIG_PACKAGE_luci=y

# WiFi AP (MT7615DN dual-band; wpad basic is enough for WPA2 AP)
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iw=y

# USB storage stack
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_usbutils=y

# Tunnel / transparent-proxy kernel support (userspace via feeds post-flash)
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-wireguard=y

# Popular kmods baked in (feed kmods can't install on custom kernels,
# so anything we might ever need goes here — still only ~+2MB)
# Filesystems: NAS shares + modern flash + filename encodings for USB sticks
CONFIG_PACKAGE_kmod-fs-cifs=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
# USB serial (console cables, LTE modems)
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
# USB network (phone tethering, LTE sticks)
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
# USB printer sharing
CONFIG_PACKAGE_kmod-usb-printer=y
# RAM relief on 256MB box + misc handy
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-loop=y
